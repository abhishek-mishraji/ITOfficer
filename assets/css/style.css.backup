:root {
  color-scheme: light;
  --bg: #f5efe7;
  --surface: rgba(255, 255, 255, 0.86);
  --text: #12201f;
  --muted: #5b6766;
  --accent: #0f766e;
  --accent-deep: #0a5e57;
  --accent-warm: #c97f3b;
  --border: rgba(18, 32, 31, 0.12);
  --shadow: 0 18px 50px rgba(15, 20, 20, 0.1);
  --shadow-strong: 0 24px 70px rgba(15, 20, 20, 0.14);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: "Source Sans 3", system-ui, sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at top left, rgba(15, 118, 110, 0.16), transparent 32%),
    radial-gradient(circle at top right, rgba(212, 158, 81, 0.14), transparent 30%),
    radial-gradient(circle at bottom left, rgba(201, 127, 59, 0.14), transparent 26%),
    linear-gradient(180deg, #f9f4ed 0%, var(--bg) 100%);
  display: grid;
  place-items: center;
  padding: 1.5rem;
  overflow-x: hidden;
}

body.compact-page {
  display: block;
}

body::before,
body::after {
  content: "";
  position: fixed;
  inset: auto;
  pointer-events: none;
  z-index: -1;
  border-radius: 999px;
  filter: blur(10px);
  opacity: 0.55;
  animation: float 16s ease-in-out infinite;
}

body::before {
  width: 14rem;
  height: 14rem;
  top: -3rem;
  right: -2rem;
  background: rgba(15, 118, 110, 0.16);
}

body::after {
  width: 12rem;
  height: 12rem;
  bottom: -2rem;
  left: -2rem;
  background: rgba(201, 127, 59, 0.16);
  animation-delay: -8s;
}

.page-shell {
  width: min(100%, 72rem);
  margin: 0 auto;
}

.shell {
  width: min(100%, 44rem);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 28px;
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
  padding: 2rem;
}

.kicker {
  margin: 0 0 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 0.78rem;
  font-weight: 800;
  color: var(--accent-deep);
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.05;
}

p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.eyebrow-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 0.85rem;
}

.status-pill,
.mini-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  min-height: 2.25rem;
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(18, 32, 31, 0.08);
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text);
}

.status-pill::before {
  content: "";
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 999px;
  background: #16a34a;
  box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.12);
}

.intro {
  margin-top: 1rem;
  max-width: 42ch;
}

.layout {
  width: min(100%, 72rem);
  display: grid;
  gap: 1rem;
}

.hero-panel,
.exam-panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 28px;
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
}

.hero-panel {
  padding: 1.5rem;
}

.hero-panel.tight {
  padding: 1.25rem;
}

.hero-copy h1 {
  font-size: clamp(2.3rem, 5vw, 4.2rem);
}

.hero-copy {
  position: relative;
  overflow: hidden;
}

.hero-copy::after {
  content: "";
  position: absolute;
  inset: auto -4rem -5rem auto;
  width: 12rem;
  height: 12rem;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(15, 118, 110, 0.2), transparent 68%);
}

.hero-grid {
  display: grid;
  gap: 1.25rem;
}

.hero-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.75rem;
  margin-top: 1.4rem;
}

.hero-meta.two-up {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.meta-card {
  padding: 0.95rem 1rem;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(18, 32, 31, 0.08);
}

.meta-card strong {
  display: block;
  margin-top: 0.25rem;
  font-size: 1rem;
}

.grid {
  display: grid;
  gap: 1rem;
  margin-top: 1.5rem;
  align-items: stretch;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 3.25rem;
  padding: 0.9rem 1.2rem;
  border-radius: 999px;
  text-decoration: none;
  font: inherit;
  font-weight: 800;
  border: 1px solid transparent;
  transition:
    transform 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    opacity 0.18s ease;
}

button.button {
  width: 100%;
  cursor: pointer;
  text-align: left;
}

.button:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-strong);
}

.button:active {
  transform: translateY(-1px) scale(0.99);
}

.button:focus-visible {
  outline: 3px solid rgba(15, 118, 110, 0.32);
  outline-offset: 3px;
}

.exam-card {
  position: relative;
  overflow: hidden;
  padding: 1.05rem 1.1rem;
  min-height: 10rem;
  background: rgba(255, 255, 255, 0.7);
  border-color: rgba(18, 32, 31, 0.08);
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}

.exam-card::after {
  content: "";
  position: absolute;
  inset: auto -2rem -2rem auto;
  width: 7rem;
  height: 7rem;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(15, 118, 110, 0.16), transparent 70%);
}

.exam-card:hover,
.exam-card.is-active {
  transform: translateY(-4px);
  box-shadow: var(--shadow-strong);
  border-color: rgba(15, 118, 110, 0.22);
}

.exam-card .label {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.35rem 0.65rem;
  border-radius: 999px;
  background: rgba(15, 118, 110, 0.08);
  color: var(--accent-deep);
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.exam-card h2,
.exam-card h3 {
  margin: 0.85rem 0 0.45rem;
  font-size: 1.45rem;
}

.exam-card p {
  max-width: 32ch;
}

.exam-card .actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
  margin-top: 1rem;
}

.exam-card .mini-note {
  margin-top: 0.85rem;
  font-size: 0.95rem;
  color: var(--muted);
}

.exam-card .preview-link {
  color: var(--accent-deep);
  font-weight: 800;
  text-decoration: none;
}

.exam-card .preview-link:hover {
  text-decoration: underline;
}

.button-primary {
  background: var(--text);
  color: #fff;
}

.button-secondary {
  background: rgba(255, 255, 255, 0.72);
  border-color: var(--border);
  color: var(--text);
}

.hint {
  margin-top: 1.25rem;
  padding: 0.9rem 1rem;
  border-radius: 16px;
  background: rgba(15, 118, 110, 0.08);
  border: 1px solid rgba(15, 118, 110, 0.18);
  color: var(--accent-deep);
  font-weight: 700;
}

.footer {
  margin-top: 1.5rem;
  font-size: 0.95rem;
}

.card {
  padding: 1rem 1.1rem;
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.68);
  border: 1px solid rgba(18, 32, 31, 0.08);
}

.preview-summary {
  margin-top: 1rem;
}

.dashboard-grid {
  display: grid;
  gap: 1rem;
}

.dashboard-card {
  padding: 1.25rem;
}

.dashboard-card h2,
.dashboard-card h3,
.dashboard-card h4 {
  margin: 0 0 0.7rem;
  font-family: inherit;
  font-size: 1.2rem;
}

.dashboard-card .subtle {
  color: var(--muted);
  font-size: 0.95rem;
}

.bullet-list {
  margin: 0.85rem 0 0;
  padding-left: 1.1rem;
  color: var(--muted);
  line-height: 1.7;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-top: 0.9rem;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 2rem;
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  background: rgba(15, 118, 110, 0.08);
  color: var(--accent-deep);
  border: 1px solid rgba(15, 118, 110, 0.14);
  font-size: 0.85rem;
  font-weight: 800;
}

.launch-summary {
  display: grid;
  gap: 0.9rem;
}

.launch-summary strong {
  font-size: 1.05rem;
}

.launch-summary .selected-date {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  font-weight: 800;
  color: var(--accent-deep);
}

.launch-summary .selected-date::before {
  content: "";
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 999px;
  background: var(--accent-warm);
}

.info-strip {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.info-strip .card {
  min-height: 100%;
}

.info-strip strong {
  display: block;
  margin-bottom: 0.35rem;
  font-size: 1rem;
}

.metrics {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.metric {
  padding: 1rem;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.66);
  border: 1px solid rgba(18, 32, 31, 0.08);
}

.metric strong {
  display: block;
  font-size: 1.5rem;
  line-height: 1;
  margin-bottom: 0.35rem;
}

.section-title {
  margin: 0 0 0.65rem;
  font-size: 1.45rem;
}

.section-copy {
  margin: 0;
}

.section-grid {
  display: grid;
  gap: 1rem;
}

.span-all {
  grid-column: 1 / -1;
}

.divider {
  width: 100%;
  height: 1px;
  background: rgba(18, 32, 31, 0.08);
  margin: 0.2rem 0;
}

.card strong {
  display: block;
  margin-bottom: 0.25rem;
}

.compact {
  width: min(100%, 42rem);
}

.compact .button {
  margin-top: 1.25rem;
  width: auto;
}

.compact-page {
  display: grid;
  place-items: center;
  min-height: 100vh;
}

.compact-page .shell {
  width: min(100%, 36rem);
}

.reveal {
  opacity: 0;
  transform: translateY(18px);
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.7s ease, transform 0.7s ease;
}

@keyframes float {
  0%,
  100% {
    transform: translate3d(0, 0, 0) scale(1);
  }
  50% {
    transform: translate3d(0, 10px, 0) scale(1.04);
  }
}

@media (min-width: 720px) {
  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .layout {
    grid-template-columns: 1.2fr 0.8fr;
    align-items: start;
  }

  .hero-grid {
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
  }
}

@media (max-width: 860px) {
  .hero-meta {
    grid-template-columns: 1fr;
  }

  .info-strip,
  .metrics {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  body {
    padding: 1rem;
  }

  .shell,
  .hero-panel {
    padding: 1.25rem;
    border-radius: 22px;
  }

  .grid {
    grid-template-columns: 1fr;
  }

  .button,
  button.button {
    width: 100%;
  }

  .exam-card {
    min-height: auto;
  }

  .hero-meta.two-up {
    grid-template-columns: 1fr;
  }
}